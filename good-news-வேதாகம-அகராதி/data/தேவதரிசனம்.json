aph":"21. <a class=\"link-dictionary-word\" href=\"?word=பவுல்\">பவுல்</a> (Paul) <a class=\"link-bible-reference\" href=\"https://www.wordofgod.in/bibles/?book=44&chapter=16&verse=9\">அப் 16:9-10</a>; <a class=\"link-bible-reference\" href=\"https://www.wordofgod.in/bibles/?book=44&chapter=18&verse=9\">அப் 18:9</a> ; 2கொரி <a class=\"link-dictionary-word\" href=\"?word=அதிகாரம்\">அதிகாரம்</a> 12)"}]}